{
  "name": "dsh-ai-company",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-workspace agent federation with persistent tickets, parallel workers, verified completion and recovery for DeepSeek Harness.",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "entry.js",
    "src",
    "vendor/dsh-superagent/lib",
    "vendor/dsh-superagent/src",
    "vendor/dsh-superagent/package.json",
    "vendor/dsh-superagent/pnpm-lock.yaml",
    "vendor/dsh-superagent/tsconfig.json",
    "vendor/dsh-superagent/tsdown.config.ts",
    "vendor/dsh-superagent/LICENSE",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "PROVENANCE.md",
    "SECURITY.md",
    "docs",
    "examples",
    "scripts",
    "tests"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pack:audit": "node scripts/pack-audit.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  }
}
